{
  "name": "1040-form-builder",
  "version": "1.0.0",
  "description": "Downloads IRS tax forms and fills them with randomized fake data",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",

    "dev": "ts-node src/main.ts",

    "download": "ts-node scripts/download.ts",
    "analyze": "ts-node scripts/analyze.ts",

    "fill": "ts-node scripts/fill.ts",
    "fill:batch": "ts-node scripts/fill.ts --count 5",
    "fill:merge": "ts-node scripts/fill.ts --merge",
    "fill:common": "ts-node scripts/fill.ts --forms f1040,f1040s1,f1040s1a,f1040s2,f1040s3,f1040sa,f1040sb,f1040sc,f1040sd,f1040se,f1040sse,f8949,f8582,f2441,f8863,f8880,f8962,f6251,f8889,f4952,f1040sr,f8606,f4684,f8283,f8839,fw2g,f8995,f8995a,f8995aa,f8995ac,f8959,f8960,f1040s8,f1040sei,fw2,f1099int,f1099div,f1099b,f1099r,f1098t,f1095a,f3921,f1099sa,fw4",

    "validate": "ts-node scripts/validate.ts",
    "answer-key": "ts-node scripts/answer-key.ts",

    "forms": "ts-node --transpile-only -e \"const {FORM_REGISTRY}=require('./src/registry/forms');FORM_REGISTRY.filter((f)=>f.pdfAvailable!==false).forEach((f)=>console.log(f.id.padEnd(16),f.displayName));\""
  },
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "pdf-lib": "^1.17.1",
    "fs-extra": "^11.2.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "p-limit": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/fs-extra": "^11.0.4",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2"
  }
}
